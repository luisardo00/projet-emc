<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STOP AU SILENCE</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #ffffff;
            scroll-behavior: smooth;
        }
        .section {
            padding: 4rem 1rem;
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            text-align: center;
        }
        /* Palette de couleurs */
        #racines { background-color: #fb923c; color: white; }
        #science { background-color: #fdf2f8; color: #be185d; }
        #impact { background-color: #f0f9ff; color: #0c4a6e; }
        #about { background-color: #ffffff; color: #1f2937; }

        .icon-large { font-size: 4rem; margin-bottom: 1rem; }
        .stat-large { font-size: 5rem; font-weight: 800; line-height: 1; }
        
        .cta-button {
            background-color: #f3705a;
            transition: all 0.3s ease;
        }
        .cta-button:hover { background-color: #e66a55; }

        #hero-banner {
            background-color: #fb923c;
            color: white; 
            border-bottom: 8px solid #fb923c; 
        }
        #hero-banner .hero-title { color: #fce7f3; }

        /* Bouton Retour en haut */
        #back-to-top {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            background-color: #EA563D;
            color: white;
            width: 3.5rem;
            height: 3.5rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            transition: all 0.3s ease;
            opacity: 0;
            visibility: hidden;
            z-index: 1000;
        }
        #back-to-top.show {
            opacity: 1;
            visibility: visible;
        }
        #back-to-top:hover {
            transform: translateY(-5px);
            background-color: #831843;
        }

        /* Animations */
        .animate-on-scroll {
            opacity: 0;
            transform: translateY(50px);
            transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        }
        .animate-on-scroll.active {
            opacity: 1;
            transform: translateY(0);
        }
        .animate-on-scroll.delay-1 { transition-delay: 0.1s; }
        .animate-on-scroll.delay-2 { transition-delay: 0.3s; }
        .animate-on-scroll.delay-3 { transition-delay: 0.5s; }
    </style>
</head>
<body>

    <div style="position: fixed; top: 1.5rem; right: 1.5rem; z-index: 5000;">
        <a href="index.html" class="bg-white text-[#fb923c] px-4 py-2 rounded-full font-bold shadow-2xl border-2 border-[#fb923c] hover:bg-[#fb923c] hover:text-white transition-all duration-300 flex items-center gap-2">
            <span>ES</span> <small>🌐</small>
        </a>
    </div>

    <div id="back-to-top" onclick="window.scrollTo(0,0)">↑</div>

    <header id="hero-banner" class="py-20 px-4 shadow-lg text-center">
        <div class="max-w-4xl mx-auto">
            <h1 class="hero-title text-5xl md:text-7xl font-extrabold tracking-tight mb-4 animate-pulse animate-on-scroll active">STOP AU SILENCE</h1>
            <p class="hero-title text-2xl md:text-3xl font-light animate-on-scroll delay-1 active">L'éducation n'attend pas</p>
            <div class="mt-8 animate-on-scroll delay-2 active">
                 <a href="#collecte" class="inline-block cta-button text-white px-8 py-4 rounded-full font-bold text-xl shadow-xl hover:shadow-2xl transition duration-300 transform hover:scale-105">
                     → Rejoignez notre cause !
                 </a>
            </div>
        </div>
    </header>

    <main class="max-w-4xl mx-auto">

        <section id="racines" class="section">
            <h2 class="text-4xl md:text-5xl font-extrabold mb-8 max-w-2xl animate-on-scroll">
                D'où vient le Tabou ?<br>Les racines du silence.
            </h2>
            <p class="text-xl font-light mb-12 max-w-xl opacity-80 animate-on-scroll delay-1">
                Le tabou n'est pas "naturel", c'est une conséquence historique de l'inégalité de genre et des croyances d'impureté. Déconstruisons les racines de la honte.
            </p>
            
            <div class="grid md:grid-cols-2 gap-8 max-w-3xl w-full">
                <div class="p-6 rounded-xl bg-white/20 backdrop-blur-sm animate-on-scroll delay-2 border border-white/10">
                    <span class="icon-large">⚖️</span> <h3 class="text-2xl font-bold mb-3">L'Origine du Tabou</h3>
                    <p class="text-lg font-light leading-relaxed">Historiquement, dans de nombreuses cultures, la menstruation a été associée à l'impureté. Ces croyances ont mené à l'isolement social des femmes.</p>
                </div>
                
                <div class="p-6 rounded-xl bg-white/20 backdrop-blur-sm animate-on-scroll delay-3 border border-white/10">
                    <span class="icon-large">🚫</span> <h3 class="text-2xl font-bold mb-3">Une Stratégie d'Exclusion</h3>
                    <p class="text-lg font-light leading-relaxed">Ces mythes ont créé des règles d'exclusion : interdiction d'activités, d'accès aux lieux de culte, ou même de toucher des aliments.</p>
                    <p class="mt-2 text-sm italic opacity-70">Exemples : interdiction de faire de la mayonnaise, de toucher des objets religieux...</p>
                </div>
            </div>
        </section>

        <section id="science" class="section">
            <h2 class="text-4xl md:text-5xl font-extrabold mb-8 max-w-3xl animate-on-scroll text-pink-700">
                Mythes vs Réalité : La vérité scientifique
            </h2>

            <p class="text-2xl font-semibold mb-12 max-w-2xl text-pink-700 animate-on-scroll delay-1">Tes règles ne sont pas un motif de honte ! Tu n'es pas seule !</p>
            
            <div class="grid md:grid-cols-3 gap-6 max-w-4xl w-full">
                <div class="p-6 rounded-xl bg-white shadow-lg border-b-4 border-fuchsia-500 animate-on-scroll delay-2">
                    <span class="icon-large text-fuchsia-600">🔬</span>
                    <h3 class="text-xl font-bold mb-3">Composition Unique</h3>
                    <p class="text-lg font-medium leading-relaxed">Le flux est un mélange riche de sang, muqueuse utérine et fluides. Ce ne sont pas des "déchets".</p>
                </div>
                
                <div class="p-6 rounded-xl bg-white shadow-lg border-b-4 border-fuchsia-500 animate-on-scroll delay-3">
                    <span class="icon-large text-fuchsia-600">🏃‍♀️</span>
                    <h3 class="text-xl font-bold mb-3">Activité Physique</h3>
                    <p class="text-lg font-medium leading-relaxed">L'activité physique peut même réduire les douleurs menstruelles et améliorer l'humeur !</p>
                </div>

                <div class="p-6 rounded-xl bg-white shadow-lg border-b-4 border-fuchsia-500 animate-on-scroll">
                    <span class="icon-large text-fuchsia-600">🧪</span>
                    <h3 class="text-xl font-bold mb-3">Différent du Sang</h3>
                    <p class="text-lg font-medium leading-relaxed">Sa couleur et sa consistance changent au fil du cycle, ce qui est totalement normal.</p>
                </div>
            </div>

            <div class="mt-12 space-y-4 animate-on-scroll delay-2">
                <p class="text-xl font-semibold text-gray-700">
                    Plus d'informations sur <a href="https://www.instagram.com/daysforgirlslfc/" class="text-fuchsia-600 hover:text-fuchsia-800 underline">@daysforgirlslfc !</a>
                </p>
                <a href="#about" class="inline-block bg-white text-fuchsia-700 border-2 border-fuchsia-700 px-6 py-2 rounded-full font-bold hover:bg-fuchsia-700 hover:text-white transition duration-300">
                    Qui sommes-nous ?
                </a>
            </div>
        </section>

        <section id="global-impact" class="section" style="background-color: #fb923c; color: white;">
            <h2 class="text-4xl md:text-5xl font-extrabold mb-8 max-w-3xl animate-on-scroll">
                Un défi sans frontières
            </h2>
            <p class="text-xl mb-12 max-w-2xl opacity-90 animate-on-scroll delay-1">
                Le manque d'accès aux produits d'hygiène et à l'éducation fait perdre des millions de jours de formation vitale aux jeunes filles.
            </p>

            <div class="grid md:grid-cols-2 gap-8 max-w-4xl w-full">
                <div class="p-8 rounded-2xl bg-white/20 backdrop-blur-sm border border-white/10 animate-on-scroll delay-2">
                    <h3 class="text-2xl font-bold mb-4">Afrique et Asie</h3>
                    <p class="text-6xl font-black mb-2">50-60</p>
                    <p class="text-lg font-semibold opacity-90">Jours perdus par an</p>
                    <p class="mt-4 text-sm font-light italic opacity-75">Dû au manque d'infrastructures et de produits durables.</p>
                </div>

                <div class="p-8 rounded-2xl bg-white/20 backdrop-blur-sm border border-white/10 animate-on-scroll delay-3">
                    <h3 class="text-2xl font-bold mb-4">Amérique Latine</h3>
                    <p class="text-6xl font-black mb-2">20-40</p>
                    <p class="text-lg font-semibold opacity-90">Jours perdus par an</p>
                    <p class="mt-4 text-sm font-light italic opacity-75">Le tabou et le coût des produits limitent la fréquentation scolaire.</p>
                </div>
            </div>
            
            <p class="mt-12 text-xl font-bold animate-on-scroll">
                Notre objectif est de réduire ces chiffres à <span class="bg-white text-[#fb923c] px-3 py-1 rounded-lg ml-1">0</span>
            </p>
        </section>

        <section id="impact" class="section">
            <h2 class="text-4xl md:text-5xl font-extrabold mb-12 max-w-2xl animate-on-scroll text-blue-900">
                Conséquences négatives : l'éducation en danger
            </h2>
            
            <div class="grid md:grid-cols-3 gap-8 max-w-4xl w-full">
                <div class="p-6 rounded-xl bg-blue-100/70 border-b-4 border-blue-700 animate-on-scroll delay-1">
                    <p class="stat-large text-blue-700">43 %</p>
                    <h3 class="text-xl font-bold mt-2">Préfèrent rester à la maison</h3>
                    <p class="text-lg font-medium opacity-80">Par honte ou manque de moyens.</p>
                </div>
                
                <div class="p-6 rounded-xl bg-blue-100/70 border-b-4 border-blue-700 animate-on-scroll delay-2">
                    <p class="stat-large text-blue-700">70 %</p>
                    <h3 class="text-xl font-bold mt-2">Ressentent de la honte</h3>
                    <p class="text-lg font-medium opacity-80">À l'idée de parler des menstruations.</p>
                </div>

                <div class="p-6 rounded-xl bg-blue-100/70 border-b-4 border-blue-700 animate-on-scroll delay-3">
                    <span class="icon-large text-blue-700">🩸</span> 
                    <h3 class="text-xl font-bold mt-2">Escuelita de Los Llanos</h3>
                    <p class="text-lg font-light mt-2">Nous cherchons à fournir des kits pour assurer la continuité scolaire.</p>
                </div>
            </div>
        </section>

        <section id="collecte" class="section bg-pink-50 text-gray-800">
            <h2 class="text-4xl md:text-5xl font-extrabold text-fuchsia-800 mb-6 animate-on-scroll">
                Aidez-nous à faire connaître cette réalité
            </h2>

            <div class="bg-white p-8 rounded-xl shadow-2xl max-w-xl w-full border-t-8 border-fuchsia-500 animate-on-scroll delay-2">
                <p class="text-lg font-bold mb-6 text-center">Choisissez comment contribuer :</p>

                <div class="mb-6 pb-6 border-b border-gray-200">
                    <h4 class="text-2xl font-extrabold text-fuchsia-700 mb-3">💰 1. Don Financier</h4>
                    <div class="bg-fuchsia-50 p-4 rounded-lg border-l-4 border-fuchsia-400 text-center">
                        <p class="font-bold text-fuchsia-800 mb-4">→ Avec 3$, vous offrez 7 jours d'école en plus par mois à une jeune fille.</p>
                    </div>
                </div>

                <div class="mb-6 pb-6 border-b border-gray-200">
                    <h4 class="text-2xl font-extrabold text-fuchsia-700 mb-3">📢 2. Partagez</h4>
                    <div class="bg-fuchsia-50 p-4 rounded-lg border-l-4 border-fuchsia-400 text-center">
                        <p class="font-bold text-fuchsia-800">Partagez le code QR ou le lien de cette page pour briser le silence !</p>
                    </div>
                </div>

                <div>
                    <h4 class="text-2xl font-extrabold text-fuchsia-700 mb-3">📧 3. Contactez-nous</h4>
                    <div class="text-left space-y-3">
                        <p class="text-lg font-semibold text-gray-700"><span class="text-fuchsia-600 mr-2">📧</span> cfcaracasclub@daysforgirls.org</p>
                        <p class="text-lg font-semibold text-gray-700"><span class="text-fuchsia-600 mr-2">📧</span> comunicacion@cfcaracas.org</p>
                        <p class="text-lg font-semibold text-gray-700"><span class="text-fuchsia-600 mr-2">📧</span> jeremy.fontaine@cfcaracas.org</p>
                    </div>
                </div>

                <p class="text-sm italic text-gray-500 mt-6 border-t pt-3">
                    Note : 100 % des fonds récoltés seront utilisés pour l'achat de kits d'hygiène pour l'Escuelita de Los Llanos (Venezuela).
                </p>
            </div>
        </section>

        <section id="about" class="section" style="background-color: #FAEBBF !important;">
            <div class="max-w-4xl mx-auto px-6 text-left">
                
                <div class="text-center mb-12 animate-on-scroll">
                    <h2 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4">Days for Girls : Transformer l'avenir</h2>
                    <p class="text-xl text-gray-800 leading-relaxed max-w-3xl mx-auto">
                        Chez <strong>Days for Girls</strong>, nous transformons les menstruations en opportunités. Nous améliorons l'accès à la santé et à l'éducation grâce à des partenariats mondiaux, en favorisant l'entrepreneuriat social et en mobilisant des solutions durables qui brisent les stigmates.
                    </p>
                </div>

                <div class="grid md:grid-cols-2 gap-12">
                    
                    <div class="animate-on-scroll delay-1">
                        <h3 class="text-2xl font-bold text-fuchsia-900 mb-4 flex items-center">
                            <span class="mr-2">💪🫵</span> Votre Impact
                        </h3>
                        <p class="text-lg text-gray-800 leading-relaxed">
                            Votre action permet aux filles, tant au Venezuela qu'à l'international, d'accéder à des produits d'hygiène et à l'éducation. En éliminant ces obstacles, vous garantissez leur présence en classe sans interruption, renforçant leur avenir.
                        </p>
                    </div>

                    <div class="animate-on-scroll delay-2">
                        <h3 class="text-2xl font-bold text-fuchsia-900 mb-4 flex items-center">
                            <span class="mr-2">🤝</span> Notre Engagement
                        </h3>
                        <div class="space-y-4">
                            <p class="text-lg text-gray-800">
                                <strong>Plaidoyer :</strong> Nous nous joignons aux efforts de sensibilisation pour impulser des changements positifs dans nos communautés.
                            </p>
                            <p class="text-lg text-gray-800">
                                <strong>Action :</strong> Nous transformons notre savoir en actes concrets, participant aux services communautaires et à l'aide humanitaire.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="mt-12 p-8 bg-white/40 rounded-2xl border border-fuchsia-900/10 animate-on-scroll delay-3">
                    <h3 class="text-2xl font-bold text-fuchsia-900 mb-6 text-center">Projets Futurs</h3>
                    <ul class="grid md:grid-cols-3 gap-6 text-center">
                        <li class="flex flex-col items-center">
                            <span class="text-3xl mb-2">📍</span>
                            <p class="text-sm font-semibold text-gray-800">Distribution de produits dans les zones vulnérables de Caracas.</p>
                        </li>
                        <li class="flex flex-col items-center border-t md:border-t-0 md:border-l md:border-r border-fuchsia-900/10 pt-4 md:pt-0 md:px-4">
                            <span class="text-3xl mb-2">🏫</span>
                            <p class="text-sm font-semibold text-gray-800">Livraison de kits Days for Girls à l'« Escuelita de Los Llanos ».</p>
                        </li>
                        <li class="flex flex-col items-center border-t md:border-t-0 pt-4 md:pt-0">
                            <span class="text-3xl mb-2">🌍</span>
                            <p class="text-sm font-semibold text-gray-800">Collecte pour le camp de réfugiés de Kyangwali (Ouganda).</p>
                        </li>
                    </ul>
                </div>

            </div>
        </section>

        <footer class="py-10 bg-gray-900 text-white text-center">
            <p class="opacity-60 text-sm">© 2026 Lycée Français de Caracas x Days for Girls</p>
        </footer>

    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const elements = document.querySelectorAll('.animate-on-scroll:not(.active)');
            const observerOptions = { threshold: 0.2 };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                        observer.unobserve(entry.target);
                    }
                });
            }, observerOptions);

            elements.forEach(el => observer.observe(el));

            const backToTop = document.getElementById('back-to-top');
            window.addEventListener('scroll', () => {
                if (window.scrollY > 500) {
                    backToTop.classList.add('show');
                } else {
                    backToTop.classList.remove('show');
                }
            });
        });
    </script>
</body>
</html>
